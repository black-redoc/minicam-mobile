<?xml version="1.0" encoding="utf-8"?>
<!-- Live fMP4 (ADR 0006): no controls, picture fitted like the MJPEG frame, and the last frame
     kept while the stream restarts. TextureView so digital zoom can scale it (spec 008). -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:keep_content_on_player_reset="true"
    app:shutter_background_color="@android:color/black" />
